# axon-os/phase1_boot/plymouth/axon.script
# ─────────────────────────────────────────
# Axon OS Plymouth Animation Script
# This runs on real Ubuntu at boot time (before the desktop loads).
# Language: Plymouth Script (subset of JS/C hybrid)
# ─────────────────────────────────────────

# ── Screen Setup ──────────────────────────
screen_width  = Window.GetWidth();
screen_height = Window.GetHeight();
cx            = screen_width  / 2;
cy            = screen_height / 2;

# ── Background ────────────────────────────
background = Rectangle();
background.SetX(0);
background.SetY(0);
background.SetWidth(screen_width);
background.SetHeight(screen_height);
background.SetColor(0.019, 0.031, 0.070, 1.0);   # Deep space #050812

# ── Logo Image ────────────────────────────
# The logo PNG is generated by:
#   cd phase1_boot/splash_simulator && python -c "import logo_generator; logo_generator.generate_logo_png('../plymouth/assets/axon_logo.png', 256)"
logo = Image("assets/axon_logo.png");
logo_sprite = Sprite(logo);
logo_sprite.SetX(cx - logo.GetWidth()  / 2);
logo_sprite.SetY(cy - logo.GetHeight() / 2 - 60);
logo_sprite.SetOpacity(0);

# ── OS Name Text ──────────────────────────
name_image = Image.Text("Axon OS", 1.0, 1.0, 1.0, 1.0, "Sans Bold 28");
name_sprite = Sprite(name_image);
name_sprite.SetX(cx - name_image.GetWidth() / 2);
name_sprite.SetY(cy + 40);
name_sprite.SetOpacity(0);

# ── Tagline Text ──────────────────────────
tag_image  = Image.Text("Intelligence Layer", 0.6, 0.75, 0.9, 1.0, "Sans 14");
tag_sprite = Sprite(tag_image);
tag_sprite.SetX(cx - tag_image.GetWidth() / 2);
tag_sprite.SetY(cy + 76);
tag_sprite.SetOpacity(0);

# ── Progress Bar ──────────────────────────
bar_width    = 280;
bar_height   = 3;
bar_x        = cx - bar_width / 2;
bar_y        = cy + 120;
progress_pct = 0;

bar_bg = Rectangle();
bar_bg.SetX(bar_x);
bar_bg.SetY(bar_y);
bar_bg.SetWidth(bar_width);
bar_bg.SetHeight(bar_height);
bar_bg.SetColor(0.08, 0.11, 0.20, 0.8);

bar_fill = Rectangle();
bar_fill.SetX(bar_x);
bar_fill.SetY(bar_y);
bar_fill.SetWidth(0);
bar_fill.SetHeight(bar_height);
bar_fill.SetColor(0.0, 0.82, 1.0, 1.0);   # Cyan #00D2FF

# ── Animation State ───────────────────────
time_elapsed = 0;
fade_in_done = 0;

# ── Main Loop (called every frame by Plymouth) ──
fun refresh_callback ()
{
    time_elapsed = time_elapsed + 1;

    # Fade in (first 60 frames ≈ 1 second)
    if (time_elapsed <= 60) {
        opacity = time_elapsed / 60.0;
        logo_sprite.SetOpacity(opacity);
        name_sprite.SetOpacity(opacity);
        tag_sprite.SetOpacity(opacity);
    } else {
        if (fade_in_done == 0) {
            fade_in_done = 1;
        }
        logo_sprite.SetOpacity(1.0);
        name_sprite.SetOpacity(1.0);
        tag_sprite.SetOpacity(1.0);
    }

    # Pulse logo (subtle scale via Y offset trick)
    pulse = Math.Sin(time_elapsed * 0.05) * 4;
    logo_sprite.SetY(cy - logo.GetHeight() / 2 - 60 + pulse);

    # Grow progress bar
    if (progress_pct < bar_width) {
        progress_pct = progress_pct + 1.4;
        bar_fill.SetWidth(progress_pct);
    }
}

Plymouth.SetRefreshFunction(refresh_callback);

# ── Boot Progress Hook ──────────────────
fun progress_callback (duration, progress)
{
    fill_target = bar_width * progress;
    progress_pct = fill_target;
    bar_fill.SetWidth(progress_pct);
}

Plymouth.SetBootProgressFunction(progress_callback);

# ── Quit (transition to desktop) ─────────
fun quit_callback ()
{
    logo_sprite.SetOpacity(0);
    name_sprite.SetOpacity(0);
    tag_sprite.SetOpacity(0);
    bar_bg.SetOpacity(0);
    bar_fill.SetOpacity(0);
}

Plymouth.SetQuitFunction(quit_callback);
